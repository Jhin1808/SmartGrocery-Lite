{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tobuylists.com" }],
      "destination": "https://www.tobuylists.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "smartgrocery.online" }],
      "destination": "https://www.tobuylists.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.smartgrocery.online" }],
      "destination": "https://www.tobuylists.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "smart-grocery-lite.vercel.app" }],
      "destination": "https://www.tobuylists.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/oauth/callback", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/lists/:path*", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/everyday", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/stores", "destination": "/index.html" },
    { "source": "/recipes", "destination": "/index.html" },
    { "source": "/templates", "destination": "/index.html" },
    { "source": "/reset", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ],
  "headers": [
    {"source": "/everyday", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/lists/:path*", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/account", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/help", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/stores", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/recipes", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/templates", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/reset", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {"source": "/oauth/:path*", "headers": [{"key": "X-Robots-Tag", "value": "noindex, follow"}]},
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
