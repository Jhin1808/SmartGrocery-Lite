# Backend
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/smartgrocery
SECRET_KEY=change_me_at_least_32_chars_in_prod
# JWT_SECRET or JWT_SECRET_KEY are also accepted aliases for SECRET_KEY.
# SESSION_SECRET is optional when SECRET_KEY/JWT_SECRET_KEY/JWT_SECRET is set.
# Koyeb can generate a runtime-only fallback if these are omitted.
SESSION_SECRET=change_me_at_least_32_chars_in_prod
REQUIRE_STRONG_SECRETS=0
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
AUTH_HEADER_FALLBACK_ENABLED=0
OAUTH_TOKEN_IN_FRAGMENT=0
OAUTH_FRAGMENT_TOKEN_PARAM=access_token
CRON_SECRET=change_me_for_scheduled_jobs

# --- Catalog / Stores / Recipes (M1+) ---
# Open Food Facts (no key required; defaults are fine)
# OFF_BASE_URL=https://world.openfoodfacts.org
# TheMealDB (no key required; defaults are fine)
# MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# Kroger Public API (free; register at https://developer.kroger.com)
# KROGER_BASE_URL=https://api.kroger.com
# KROGER_CLIENT_ID=
# KROGER_CLIENT_SECRET=
# KROGER_SCOPES=product.compact
# KROGER_TOKEN_CACHE_TTL_SECONDS=1500

# Cache + rate limits
# CATALOG_CACHE_TTL_HOURS=24
# CATALOG_TIMEOUT_SECONDS=4
# CATALOG_RATE_LIMIT_PER_MIN=30

# Reserved for future paid tier (off in v1)
# SPOONACULAR_API_KEY=
# EDAMAM_APP_ID=
# EDAMAM_APP_KEY=

# Frontend
REACT_APP_API_BASE=http://localhost:8000
REACT_APP_AUTH_FALLBACK_STORAGE_KEY=token
REACT_APP_TOKEN_FRAGMENT_PARAM=access_token
REACT_APP_AUTH_HEADER_FALLBACK_ENABLED=0
# Catalog / stores / recipes feature flags (all default to ON)
# REACT_APP_ENABLE_CATALOG=1
# REACT_APP_ENABLE_KROGER=1
# REACT_APP_ENABLE_RECIPES=1
